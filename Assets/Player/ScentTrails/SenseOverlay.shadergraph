    "m_Name": "ScentWaves (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -993.0,
            "y": 199.99998474121094,
            "width": 224.0,
            "height": 358.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "e0ce6feee0c0497889ef66031208e4b3"
        },
        {
            "m_Id": "6581dd0eb489424a86a81229f23ca680"
        },
        {
            "m_Id": "92bb7844bd91491e902985808902f7ff"
        },
        {
            "m_Id": "a5685edc71514350b215ffc873adbff1"
        },
        {
            "m_Id": "db3368eb82a245f19541be80d0517bb1"
        },
        {
            "m_Id": "88014e40b1c54233914eed8e0454bb31"
        },
        {
            "m_Id": "3c10db265c4844a0b5fb601ea85479ea"
        },
        {
            "m_Id": "380abba9516441dab98620ab025ee7db"
        },
        {
            "m_Id": "dafcb480c6184ac1b0984f356201ed82"
        },
        {
            "m_Id": "ad3481a71cab42feafabe31e3d470dd5"
        },
        {
            "m_Id": "865d2eb7a5d8492eb0c6f46dff06fec1"
        },
        {
            "m_Id": "4aff9564b02f451cb2b766de55bdeb2c"
        },
        {
            "m_Id": "9600cd80e01645fabb19003ea4df4081"
        },
        {
            "m_Id": "ccc778f4679d4019aebc59f3c41850e3"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "ScentWaves",
    "m_FunctionSource": "fcc020492d71a425989dc1b3af212ca4",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Inputs: UV, Center (Vector2); Aspect, Time, Rays, WiggleAmp, WiggleFreq,\n//         Speed, Width, PuffDensity, InnerRadius (Float). Output: Out (Float).\nfloat2 d = (UV - Center) * float2(Aspect, 1.0);\nfloat r = length(d);\nfloat a = (atan2(d.y, d.x) / 6.2831853 + 0.5) * Rays;   // 0..Rays around the circle\n\nfloat id = floor(a);\nfloat seed = frac(sin(id * 127.1) * 43758.5453);        // per-ray random, so rays don't move in lockstep\n\n// sideways wiggle that travels outward (keep WiggleAmp <= 0.3)\na += sin(r * WiggleFreq - Time * Speed + seed * 6.2831853) * WiggleAmp;\n\n// distance from the ray's centre in screen units, so rays don't fatten with distance\nfloat across = abs(frac(a) - 0.5) * (6.2831853 * r / Rays);\nfloat ray = 1.0 - smoothstep(0.0, Width, across);\n\n// break each ray into puffs drifting outward\nfloat puff = frac(r * PuffDensity - Time * Speed * 0.5 + seed);\npuff = smoothstep(0.0, 0.2, puff) * (1.0 - smoothstep(0.5, 1.0, puff));\n\n// clear space around the player, fade toward the screen edge\nfloat fade = smoothstep(InnerRadius, InnerRadius + 0.1, r) * (1.0 - smoothstep(0.6, 1.0, r));\n\nOut = ray * puff * fade;"
}

